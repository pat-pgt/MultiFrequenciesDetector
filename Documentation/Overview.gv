digraph g {
		size="8.267,11.7";
		margin=0;
		node [ shape=record ];
		newrank = true;
		subgraph cluster_0{
				 cordic_RZ_2_XY [
				 				label = "{Cordic stage\nRuns one shift of the algo\nto converge Z to 0.}";
				 				];
				 metadata_Z20_fifo [
				 				   label="FIFO as many elements\nas Cordic stages";
								   ];
								   one_gene [
								   label = "1";
								   shape="ellipse";
								   ];
								   cordic_RZ_2_XY:se -> cordic_RZ_2_XY:ne [color = "darkred"; label="X"];
								   cordic_RZ_2_XY:se -> cordic_RZ_2_XY:ne [color = "darkred"; label="Y"];
								   cordic_RZ_2_XY:se -> cordic_RZ_2_XY:ne [color = "darkgreen"; label="Z"];
								   one_gene -> cordic_RZ_2_XY [color = "darkblue"; label="strobe"];
								   label="N (1 shift) Cordic stages";
		}
		angles_generator_run [
							 label = "{|Angles generator|Generates sequentially\nthe current angles\nfor all the channels.}";
							 color="darkgreen";
		];
		"angles_generator_run" -> "cordic_RZ_2_XY" [ color = "darkgreen"; label="angle" ];
		"angles_generator_run" -> "metadata_Z20_fifo" [ color = "darkblue"; label="metadata" ];
		"input_val" -> "cordic_RZ_2_XY"    [ color = "darkred"; label = "X" ];
		"zero_Y" -> "cordic_RZ_2_XY"    [ color = "darkred"; label = "Y" ];
		input_val [
		label = "{\<from hardware\>|Value latched or not\non the entire frame.}"];
		color="black";
		zero_Z [
		label = "0";
		shape="ellipse";
		];
		zero_Y [
		label = "0";
		shape="ellipse";
		];
		subgraph cluster_1{
				 pre_filter [
				 label = "{Pre-filter|Low-pass filter\nusing a minimum or resources\naccording to the meta-data.}";
				 color = "darkgreen";
				 ];
				 metadata_prefilter_fifo [
				 label="FIFO as many elements\nas prefilter stages";
				 ];
				 label="M prefilter stages";
				 pre_filter:se -> pre_filter:ne[color = "darkred"; label="X"];
				 pre_filter:se -> pre_filter:ne [color = "darkred"; label="Y"];
				 "metadata_prefilter_fifo" -> pre_filter [ label = "MD"; color = "darkblue" ];
		}
		void_Z20  [
		label = "Void";
		shape = "ellipse";
		color = "darkgreen";
		];
		void_Y20  [
		label = "Void";
		shape = "ellipse";
		color = "darkgreen";
		];
		"metadata_Z20_fifo" -> "metadata_prefilter_fifo" [ label = "MD"; color = "darkblue" ];
		"cordic_RZ_2_XY" -> "pre_filter" [ label = "X" ; color = "darkred" ];
		"cordic_RZ_2_XY" -> "pre_filter" [ label = "Y" ; color = "darkred" ];
		"cordic_RZ_2_XY" -> "void_Z20" [ color = darkgreen ];
		subgraph cluster_2 {
				 downsampler [
				 			label = "{Down-sampler|Down samples\naccording to the meta-data.}";
										color = "black";
							];
				 metadata_downsampler_fifo [
										   label="FIFO as many elements\nrequired by the down sampler"
										   ];
			    "metadata_downsampler_fifo" -> downsampler [ label = "MD"; color = "darkblue" ];
				label = "Downsmpling";
		}
		"metadata_prefilter_fifo" -> "metadata_downsampler_fifo" [ label = "MD" ; color = "darkblue" ];
		"pre_filter" -> "downsampler" [ label = "X" ; color = "darkred" ];
		"pre_filter" -> "downsampler" [ label = "Y" ; color = "darkred" ];
		subgraph cluster_3 {
				 main_filter [
				 			 label = "{Main filter|Low-pass filter\nusing Bessel 5th order\naccording to the meta-data.}";
				 			 color = "darkgreen";
				];
				metadata_mainfilter_fifo [
										 label="FIFO as many elements\nrequired by the main filter"
				];
		"metadata_mainfilter_fifo" -> main_filter [ label = "note only"; color = "darkblue" ];
		"metadata_mainfilter_fifo" -> main_filter [ label = "strobe"; color = "darkblue" ];
		label = "Main filter";
		}
		"downsampler" -> "metadata_mainfilter_fifo" [ label = "strobe" ; color = "darkblue" ];
		"metadata_downsampler_fifo" -> "metadata_mainfilter_fifo" [ label = "MD" ; color = "darkblue" ];
		"downsampler" -> "main_filter" [ label = "X" ; color = "darkred" ];
		"downsampler" -> "main_filter" [ label = "Y" ; color = "darkred" ];
		subgraph cluster_4 {
				 cordic_XY_2_RZ [
				 				label = "{Cordic stage.\nRuns P shits of the algo\n to converge Y to 0.}";
				];
				metadata_Y20_fifo [
								label="FIFO as many elements\nrequired by the main filter"
				];
				"metadata_Y20_fifo" -> cordic_XY_2_RZ  [ label = "strobe" ; color = "darkblue" ];
				"metadata_Y20_fifo" -> cordic_XY_2_RZ [ label = "MD" ; color = "darkblue" ];
				cordic_XY_2_RZ:se -> cordic_XY_2_RZ:ne[color = "darkred"; label="X"];
				cordic_XY_2_RZ:se -> cordic_XY_2_RZ:ne [color = "darkred"; label="Y"];
				cordic_XY_2_RZ:se -> cordic_XY_2_RZ:ne [color = "darkgreen"; label="Z"];
				label = "Q (P shifts) Cordic stages"
		}
		"metadata_mainfilter_fifo" -> "metadata_Y20_fifo" [ label = "MD" ; color = "darkblue" ];
		"metadata_mainfilter_fifo" -> "metadata_Y20_fifo" [ label = "strobe" ; color = "darkblue" ];
		"main_filter" -> "cordic_XY_2_RZ" [ label = "X" ; color = "darkred" ];
		"main_filter" -> "cordic_XY_2_RZ" [ label = "Y" ; color = "darkred" ];
		"zero_Z" -> "cordic_XY_2_RZ" [ label = "Z"; color = "darkgreen" ];

		cordic_XY_2_RZ -> void_Y20 [ label = "Y"; color = "darkred" ];
		output_data [
					label = "{Output|\<to display or hardware\>}"
					];
		color="darkgreen";
		"cordic_XY_2_RZ" -> "output_data" [ label = "X"; color = "darkred" ];
		"cordic_XY_2_RZ" -> "output_data" [ label = "Z"; color = "darkgreen" ];
		"metadata_Y20_fifo" -> "output_data" [ label = "MD"; color = "darkblue" ];
		"metadata_Y20_fifo" -> "output_data" [ label = "strobe"; color = "darkblue" ];
}